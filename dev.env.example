# Settings of the dev device for the scripts in scripts/dev (ADR-0212). Copy this file to
# dev.env at the root of the main checkout; the owner fills in the passwords:
#
#   cp dev.env.example dev.env && chmod 600 dev.env      (make setup does this when it is missing)
#
# A git worktree of that checkout uses its dev.env unless the worktree has one of its own;
# UNOS_DEV_ENV_FILE in the environment names another file.
#
# git ignores dev.env. It holds passwords, so the scripts refuse it unless it belongs to you
# and has mode 600. Never paste its values into a command line, a chat, a log or a commit: the
# scripts pass passwords to ssh through SSH_ASKPASS and to the device on standard input.
#
# Format: NAME=value, one per line, the value taken literally (no quotes needed, no $-expansion);
# lines starting with # are comments. Names containing PASS, TOKEN, SECRET, API_KEY or
# PRIVATE_KEY are secrets and are never put into the environment (see scripts/dev/env.sh).

# The device: its address (or host name) and the SSH user. The scripts need root there (docker,
# mount namespaces, testparm).
UNOS_DEV_HOST=10.1.1.103
UNOS_DEV_SSH_USER=root
# Empty: SSH keys only (preferred). Set: ssh tries the keys first, then this password.
UNOS_DEV_SSH_PASSWORD=

# The UNOS checkout on the device that the images are built from.
UNOS_DEV_REPO=/opt/unos
# The device's system disk (a name in /sys/block), whose writes every step reports. Empty: the
# disk that holds the device's root filesystem.
UNOS_DEV_SYSTEM_DISK=mmcblk1

# The UNOS administrator that scripts/dev/api.py signs in as.
UNOS_DEV_ADMIN_USER=admin
UNOS_DEV_ADMIN_PASSWORD=

# The web login of the transmission app installed on the device (its catalog template requires
# one: USER and PASS).
TRANSMISSION_USER=
TRANSMISSION_PASS=

# Optional (defaults in scripts/dev/env.sh):
# UNOS_DEV_SSH_KEY=        a private key file for ssh to use, alone
# UNOS_DEV_KNOWN_HOSTS=    a known_hosts file instead of ~/.ssh/known_hosts
# UNOS_DEV_LOCK_WAIT=900   seconds to wait for another holder of the device lock
# UNOS_DEV_STATE_DIR=      where deploy.sh keeps rollback copies and the newest 3 backups, which
#                          hold the device's secrets (default: tmp/dev of the main checkout,
#                          ignored by git)
