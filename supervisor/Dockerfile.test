# The base of supervisor/Dockerfile, by tag and digest (ADR-0305).
FROM python:3.11-slim@sha256:65bd3d9f1d7fa268dd1909973ba7eb4bdf41f6dcf2cfbe76ba9528b170f3fd79

WORKDIR /app

# Install system dependencies including curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    btrfs-progs \
    smartmontools \
    gcc \
    python3-dev \
    iproute2 \
    ethtool \
    procps \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# Wheels only, as supervisor/Dockerfile installs them (ADR-0422).
RUN pip install --no-cache-dir --only-binary=:all: -r requirements.txt

# Copy application code
COPY src/ ./src/

# Create test directories
# testpool: a pool directory for the file manager E2E tests (the API cannot
# create one directly in /mnt/pools). Docker copies it into the new test-pools
# volume; an existing volume needs `docker volume rm unos-test_test-pools`.
RUN mkdir -p /data /mnt/pools/testpool /etc/samba

# Initialize test data
COPY tests/fixtures/init-test-data.sh /init-test-data.sh
RUN chmod +x /init-test-data.sh

# No .pyc files: the container's writable layer is on the system disk (SD card).
ENV PYTHONDONTWRITEBYTECODE=1

EXPOSE 8080

# Use entrypoint that sets up test data before starting. Trusted proxy
# addresses come from FORWARDED_ALLOW_IPS, and --ws-max-size and
# --ws-per-message-deflate are the same as in supervisor/Dockerfile (see there).
ENTRYPOINT ["/bin/bash", "-c", "/init-test-data.sh && exec uvicorn src.main:app --host 0.0.0.0 --port 8080 --proxy-headers --ws-max-size 65536 --ws-per-message-deflate false --limit-concurrency 128 --timeout-graceful-shutdown 3"]
