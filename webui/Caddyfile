# UNOS web UI: serves the SvelteKit app and proxies the API and WebSockets to
# the supervisor.
#
# The UI is served over HTTPS on 443 with certificates from Caddy's own local
# CA ("tls internal"), so passwords, tokens and TOTP codes never cross the
# network in cleartext. Browsers warn about the certificate until the CA root
# is trusted on the client; it is kept in the caddy-data volume at
# /data/caddy/pki/authorities/local/root.crt (inside the webui container).
# Or with a stored certificate that an administrator chose on the Security page
# (ADR-0404): UNOS_TLS picks the site below.
# Plain HTTP on 80 only redirects (plus the health check, see below).
#
# No Strict-Transport-Security header: browsers do not let users click through
# certificate errors on an HSTS host. If the local CA is ever recreated (lost
# volume, reinstall), every browser that had trusted the old root would be
# locked out of the device until its HSTS entry expires.
#
# webui/Dockerfile copies this file into the image as /etc/caddy/Caddyfile.
{
	# A LAN appliance must never ask a public ACME CA for certificates.
	local_certs
	# Installing the local root into the container's own trust store is useless.
	skip_install_trust
	# Clients that connect by IP address send no SNI (IP literals are not
	# allowed there), and a name we hold no certificate for (e.g. nas.local)
	# would abort the handshake. Both get the certificate for UNOS_HOSTNAME,
	# so the browser shows its certificate warning instead of a TLS error.
	default_sni {$UNOS_HOSTNAME:unos}
	fallback_sni {$UNOS_HOSTNAME:unos}
	# The HTTP->HTTPS redirect is defined below so the health check can stay
	# reachable over plain HTTP.
	auto_https disable_redirects
	# A served certificate (ADR-0404) that names an OCSP responder would make
	# Caddy ask the responder at every load and keep refreshing a staple in
	# caddy-data, on the system disk (ADR-0214); a LAN appliance staples none.
	ocsp_stapling off
	servers {
		# HTTP/3 needs UDP 443, which docker-compose does not publish. Without
		# it, browsers open WebSockets with the plain HTTP/1.1 upgrade.
		protocols h1 h2
		# A header block over 16 KB gets 431 before it reaches the supervisor (ADR-0333): far
		# above a browser's (with the session token), far below Caddy's default of 1 MB.
		max_header_size 16KB
	}
}

# The site's headers and routes, for both TLS sites below.
(unos-site) {
	header {
		# Applied after reverse_proxy, so these values always win.
		defer
		# Inline scripts: the meta CSP that SvelteKit writes into index.html
		# (csp of sveltekit() in vite.config.ts) allows only the hashed bootstrap
		# script; both policies apply, so 'unsafe-inline' here does not
		# widen that. This header carries everything a static file cannot:
		# frame-ancestors, and the WebSocket origin of the current host
		# (Safari does not treat wss: as 'self').
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://{hostport}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}

	handle /api/* {
		reverse_proxy supervisor:8080
	}

	handle /ws/* {
		reverse_proxy supervisor:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Caddy's local CA (ADR-0025). The named address makes Caddy issue (and renew)
# a certificate for UNOS_HOSTNAME; "https://" matches all other hosts.
(tls-local) {
	{$UNOS_HOSTNAME:unos}, https:// {
		tls internal
		import unos-site
	}
}

# The stored certificate that an administrator chose (ADR-0404): the supervisor
# writes it with its chain and key into the one file of the served-certificate
# volume (deploy/docker-compose.yml), which this container mounts read-only.
# Every host name, IP address and client without a name gets it: no address
# names UNOS_HOSTNAME, so Caddy manages no certificate of its own beside it.
(tls-served) {
	https:// {
		tls /served-certificate/served.pem /served-certificate/served.pem
		import unos-site
	}
}

# UNOS_TLS=served once the web UI's command (deploy/docker-compose.yml) found
# that the served file loads, and in the `caddy reload` that the supervisor runs
# in this container after a change (supervisor/src/security/serving.py);
# otherwise Caddy's local CA.
import tls-{$UNOS_TLS:local}

# Local names of apps (ADR-0420): one site per name, <label>-<host name>.local, HTTPS from the
# local CA, proxied to the app's port on the host. The supervisor writes them into the volume
# app-names (deploy/docker-compose.yml), read-only here, and reloads Caddy. The web UI's command
# sets UNOS_APP_NAMES=off when they do not validate, so that the glob matches nothing then and
# the web UI starts without them; the supervisor's `caddy reload` leaves it unset (on).
import /app-names/{$UNOS_APP_NAMES:on}/*.caddy

http:// {
	# Health checks (install.sh, update.sh, monitors) keep working over HTTP.
	handle /api/v1/health {
		reverse_proxy supervisor:8080
	}

	handle {
		redir https://{host}{uri} 308
	}
}
