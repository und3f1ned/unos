# Playwright Test Runner Dockerfile
# The tag must be the @playwright/test version in package-lock.json: the image
# carries the browsers, and their system libraries, of exactly that version.
# supervisor/tests/test_deploy_scripts.py checks it.
FROM mcr.microsoft.com/playwright:v1.65.0-noble

WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm ci

# Copy test files and configuration
COPY tests/ ./tests/
COPY playwright.config.ts ./

# Create directories for test artifacts
RUN mkdir -p test-results playwright-report

# Default command runs all tests. The test-runner of
# deploy/docker-compose.test.yml runs the same command after it has created
# the test account.
CMD ["npx", "playwright", "test", "--reporter=list,html"]
