{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Read(./dev.env)",
      "Read(./**/dev.env)",
      "Read(//**/dev.env)",
      "Read(//**/tmp/dev/backup/**)",
      "Write(//**/tmp/stop-check/**)",
      "Edit(//**/tmp/stop-check/**)",
      "mcp__plugin_desktop-commander_desktop-commander"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
